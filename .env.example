# ---------------------------------------------------------------------------
# Banco de dados
# Local (Docker):   postgresql://totem:totem_dev@localhost:5432/totem
# Supabase (prod):  DATABASE_URL = pooler em modo transação (porta 6543)
#                   DIRECT_URL   = conexão direta ou pooler em modo sessão (porta 5432), usada pelas migrations
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://totem:totem_dev@localhost:5432/totem"
DIRECT_URL="postgresql://totem:totem_dev@localhost:5432/totem"

# ---------------------------------------------------------------------------
# Segredos — gere com: npm run gen:keys   (NUNCA reutilize os valores de dev em produção)
# ---------------------------------------------------------------------------
# Chave AES-256-GCM (32 bytes em base64) que cifra relatos, identificação e respostas.
ENCRYPTION_KEY=""
# Opcional: chave anterior, aceita apenas para leitura durante uma rotação.
ENCRYPTION_KEY_PREVIOUS=""
# HMAC dos códigos de protocolo (o banco nunca guarda o protocolo em claro).
PROTOCOL_PEPPER=""
# HMAC do IP, usado SOMENTE no rate limiting do login do /admin (nunca no totem).
IP_HASH_SECRET=""
# Protege a rota do job de retenção (Vercel Cron envia "Authorization: Bearer <CRON_SECRET>").
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Apenas desenvolvimento / seed
# ---------------------------------------------------------------------------
# Token do totem de teste criado pelo seed (usado pelos testes e2e).
SEED_DEVICE_TOKEN="dev-totem-token-nao-usar-em-producao"
# Senha do admin de teste criado pelo seed.
SEED_ADMIN_PASSWORD="Acolher-Totem-2026!"
